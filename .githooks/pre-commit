#!/usr/bin/env bash
# VarDictRust Native Git Pre-Commit Hook
# Fast hygiene, syntax, release-surface, and secret scan gate (<3 seconds).
set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

ts() { date '+[%H:%M:%S]'; }
HOOK_T0=$SECONDS
export RUST_TEST_THREADS="${RUST_TEST_THREADS:-4}"
export RAYON_NUM_THREADS="${RAYON_NUM_THREADS:-4}"

STAGED_ALL=$(git diff --cached --name-only --diff-filter=ACMRD || true)
STAGED_EXISTING=$(git diff --cached --name-only --diff-filter=ACMR || true)

# 1. Inspect staged Rust/Cargo files to enable fast path for doc-only commits
STAGED_RS=$(echo "$STAGED_ALL" | grep -E '\.rs$|Cargo\.(toml|lock)$' || true)

if [ -n "$STAGED_RS" ]; then
    st_t0=$SECONDS
    echo "=== $(ts) [pre-commit] Checking code formatting (cargo fmt) ==="
    if ! cargo fmt --all -- --check; then
        echo "ERROR: Code formatting check failed. Run 'cargo fmt --all' to fix." >&2
        exit 1
    fi
    echo "$(ts) [pre-commit] cargo fmt PASS ($((SECONDS - st_t0))s)"

    st_t0=$SECONDS
    echo "=== $(ts) [pre-commit] Checking lints (cargo clippy) ==="
    if ! cargo clippy --all-targets --all-features -- -D warnings -A clippy::needless_late_init -A clippy::byte_char_slices; then
        echo "ERROR: Clippy linter found warnings. Fix warnings before committing." >&2
        exit 1
    fi
    echo "$(ts) [pre-commit] cargo clippy PASS ($((SECONDS - st_t0))s)"
else
    echo "=== $(ts) [pre-commit] No Rust or Cargo files staged; skipping cargo fmt/clippy ==="
fi

# 1b. Offline-safe supply-chain & CI policy checks when dependency/workflow files are staged
STAGED_DEPS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '(^|/)Cargo\.(toml|lock)$|^deny\.toml$|^\.cargo/audit\.toml$' || true)
if [ -n "$STAGED_DEPS" ]; then
    if command -v cargo-deny >/dev/null 2>&1; then
        echo "Running offline supply-chain check (cargo deny --offline --all-features check advisories licenses bans sources)..."
        if [ -d "${CARGO_HOME:-$HOME/.cargo}/advisory-dbs" ]; then
            cargo deny --offline --all-features check advisories licenses bans sources
        else
            cargo deny --offline --all-features check licenses bans sources
        fi
    fi
    if command -v cargo-audit >/dev/null 2>&1 && [ -d "${CARGO_HOME:-$HOME/.cargo}/advisory-db" ]; then
        echo "Running offline RustSec advisory check (cargo audit -n --stale)..."
        cargo audit -n --stale
    fi
fi

STAGED_CI_POLICY=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^\.github/workflows/.*\.yml$|^\.github/dependabot\.yml$|^deny\.toml$|^\.cargo/audit\.toml$' || true)
if [ -n "$STAGED_CI_POLICY" ]; then
    echo "Running CI & supply-chain policy contract tests (test_bioconda_recipe.py)..."
    python3 harness/tests/test_bioconda_recipe.py
fi

# 2. Fast syntax check for staged shell scripts and git hooks (<0.2s)
STAGED_SH=$(echo "$STAGED_EXISTING" | grep -E '\.sh$|^\.githooks/' || true)
if [ -n "$STAGED_SH" ]; then
    st_t0=$SECONDS
    echo "=== $(ts) [pre-commit] Syntax-checking staged shell scripts (bash -n) ==="
    while IFS= read -r sh_file; do
        [ -n "$sh_file" ] && [ -f "$sh_file" ] && bash -n "$sh_file"
    done <<< "$STAGED_SH"
    echo "$(ts) [pre-commit] shell syntax PASS ($((SECONDS - st_t0))s)"
fi

# 3. Fast compile & stdlib-purity check for staged Python scripts (<0.3s)
STAGED_PY=$(echo "$STAGED_EXISTING" | grep -E '\.py$' || true)
if [ -n "$STAGED_PY" ]; then
    st_t0=$SECONDS
    echo "=== $(ts) [pre-commit] Checking staged Python scripts (py_compile & stdlib purity) ==="
    while IFS= read -r py_file; do
        [ -n "$py_file" ] && [ -f "$py_file" ] && python3 -m py_compile "$py_file"
    done <<< "$STAGED_PY"
    python3 harness/tests/test_stdlib_purity.py >/dev/null
    echo "$(ts) [pre-commit] Python hygiene PASS ($((SECONDS - st_t0))s)"
fi

# 4. Fast release consistency check when workflows or release-tracked surfaces are staged (<0.3s)
STAGED_REL=$(echo "$STAGED_ALL" | grep -E '^\.github/workflows/.*\.yml$|^Cargo\.(toml|lock)$|^CITATION\.cff$|^CHANGELOG\.md$|^README\.md$|^DIVERGENCES\.md$|^CONTRIBUTING\.md$|^mkdocs\.yml$|^wiki/|^docs/(testing|validation|release)/|^\.agents/skills/' || true)
if [ -n "$STAGED_REL" ]; then
    st_t0=$SECONDS
    echo "=== $(ts) [pre-commit] Verifying release consistency surfaces ==="
    python3 .agents/skills/vardictrust-release/scripts/check_release_consistency.py --phase pre-tag
    echo "$(ts) [pre-commit] release consistency PASS ($((SECONDS - st_t0))s)"
fi

# 5. Portable secret scan on staged index
st_t0=$SECONDS
echo "=== $(ts) [pre-commit] Scanning staged changes for secrets (gitleaks) ==="
GITLEAKS_BIN=""
if command -v gitleaks >/dev/null 2>&1; then
    GITLEAKS_BIN="gitleaks"
elif [ -n "${CONDA_PREFIX:-}" ] && [ -x "${CONDA_PREFIX}/bin/gitleaks" ]; then
    GITLEAKS_BIN="${CONDA_PREFIX}/bin/gitleaks"
elif [ -x "${HOME}/miniconda3/envs/g4-tools/bin/gitleaks" ]; then
    GITLEAKS_BIN="${HOME}/miniconda3/envs/g4-tools/bin/gitleaks"
elif [ -x "${HOME}/miniforge3/envs/g4-tools/bin/gitleaks" ]; then
    GITLEAKS_BIN="${HOME}/miniforge3/envs/g4-tools/bin/gitleaks"
elif [ -x /home/palak/miniconda3/envs/g4-tools/bin/gitleaks ]; then
    GITLEAKS_BIN="/home/palak/miniconda3/envs/g4-tools/bin/gitleaks"
fi

if [ -n "$GITLEAKS_BIN" ]; then
    "$GITLEAKS_BIN" protect --staged -v
    echo "$(ts) [pre-commit] gitleaks PASS ($((SECONDS - st_t0))s)"
else
    echo "WARNING: gitleaks not found on PATH or in conda environments; skipping staged secret scan." >&2
fi

# 6. Block agent planning scratch directories
if echo "$STAGED_EXISTING" | grep -E '^docs/superpowers/' >/dev/null; then
    echo "ERROR: docs/superpowers/ files must not be committed to the repository." >&2
    echo "Agent plans belong in <appDataDir>/brain/<conversation-id>/ artifacts." >&2
    exit 1
fi

echo "=== $(ts) [pre-commit] All pre-commit checks passed ($((SECONDS - HOOK_T0))s) ==="
