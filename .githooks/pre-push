#!/usr/bin/env bash
# VarDictRust Native Git Pre-Push Hook
# Blocks direct pushes to main, detects merge conflicts with origin/main, and enforces fast smoke & robustness gate (<30s).
set -euo pipefail

ts() { date '+[%H:%M:%S]'; }
HOOK_T0=$SECONDS
export RUST_TEST_THREADS="${RUST_TEST_THREADS:-4}"
export RAYON_NUM_THREADS="${RAYON_NUM_THREADS:-4}"
export RUST_THREADS="${RUST_THREADS:-1}"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# 1. Parse all push ref updates from stdin
# Format: <local_ref> <local_oid> <remote_ref> <remote_oid>
REFS=()
while read -r local_ref local_oid remote_ref remote_oid; do
    REFS+=("$local_ref" "$local_oid" "$remote_ref" "$remote_oid")
done

# If hook invoked without stdin refs, exit clean
if [ ${#REFS[@]} -eq 0 ]; then
    exit 0
fi

# 2. Check for forbidden direct pushes to main
for ((i=0; i<${#REFS[@]}; i+=4)); do
    remote_ref="${REFS[i+2]}"
    if [[ "$remote_ref" =~ refs/heads/main$ ]]; then
        echo "================================================================================" >&2
        echo " ERROR: Direct push to 'main' is forbidden by repository governance!" >&2
        echo " All changes must be pushed to a feature branch and merged via Pull Request." >&2
        echo "================================================================================" >&2
        exit 1
    fi
done

# 3. Accumulate changed files across all non-deletion ref updates using actual OIDs
ALL_CHANGED_FILES=""
HAS_NON_DELETION=false
ZERO_OID="0000000000000000000000000000000000000000"

for ((i=0; i<${#REFS[@]}; i+=4)); do
    local_oid="${REFS[i+1]}"
    remote_oid="${REFS[i+3]}"

    # Skip branch deletions
    if [[ "$local_oid" == "$ZERO_OID" ]]; then
        continue
    fi

    HAS_NON_DELETION=true

    if [[ "$remote_oid" == "$ZERO_OID" ]]; then
        # New branch push: inspect diff against origin/main, main, or root commit
        CHANGED=$(git diff --name-only origin/main..."$local_oid" 2>/dev/null || git diff --name-only main..."$local_oid" 2>/dev/null || git diff-tree --no-commit-id --name-only -r "$local_oid" 2>/dev/null || true)
    else
        # Existing branch update: inspect exact pushed commit range
        CHANGED=$(git diff --name-only "$remote_oid".."$local_oid" 2>/dev/null || true)
    fi
    ALL_CHANGED_FILES="$ALL_CHANGED_FILES"$'\n'"$CHANGED"
done

# If only deletions were pushed, allow immediately
if [ "$HAS_NON_DELETION" = false ]; then
    exit 0
fi

# 4. Git-2.34-compatible 3-way mergeability guard against origin/main
# When a branch has merge conflicts with origin/main, GitHub sets mergeable=false and
# silently skips all 'on: pull_request:' GitHub Actions workflows.
git fetch origin main --quiet 2>/dev/null || true

# 4a. Block pushing release tags (refs/tags/v*) whose target commit is not on origin/main
for ((i=0; i<${#REFS[@]}; i+=4)); do
    local_ref="${REFS[i]}"
    local_oid="${REFS[i+1]}"
    remote_ref="${REFS[i+2]}"
    if [[ "$local_oid" == "$ZERO_OID" ]]; then
        continue
    fi
    if [[ "$remote_ref" == refs/tags/v* || "$local_ref" == refs/tags/v* ]]; then
        tag_commit="$(git rev-parse --verify "${local_oid}^{commit}" 2>/dev/null || true)"
        if [ -z "$tag_commit" ] || ! git merge-base --is-ancestor "$tag_commit" origin/main 2>/dev/null; then
            echo "================================================================================" >&2
            echo " ERROR: Release tag '${remote_ref}' (${local_oid}) is not an ancestor of 'origin/main'!" >&2
            echo " Merge the release branch to 'main' before pushing version tags." >&2
            echo "================================================================================" >&2
            exit 1
        fi
    fi
done
if git rev-parse --verify origin/main >/dev/null 2>&1; then
    if ! git merge-base --is-ancestor origin/main HEAD 2>/dev/null; then
        base="$(git merge-base origin/main HEAD 2>/dev/null || true)"
        if [[ -n "$base" ]] && git merge-tree "$base" origin/main HEAD | awk '/^\+<<<<<<< \.our$/ { found=1 } END { exit !found }'; then
            echo "================================================================================" >&2
            echo " ERROR: Branch has merge conflicts with 'origin/main'!" >&2
            echo " GitHub Actions skips all 'on: pull_request:' workflows when a PR cannot merge." >&2
            echo " Resolve conflicts before pushing: git fetch origin main && git rebase origin/main" >&2
            echo "================================================================================" >&2
            exit 1
        fi
    fi
fi

# 4b. Fast Zensical strict build gate when Markdown or documentation config changes (<4s)
DOC_CHANGES=$(echo "$ALL_CHANGED_FILES" | grep -E '\.md$|^zensical\.toml$|^mkdocs\.yml$|^\.readthedocs\.yaml$|^docs/|^harness/prepare_docs_site\.py$|^harness/tests/test_docs_ui\.py$' || true)
if [ -n "$DOC_CHANGES" ] && [ -f "$ROOT_DIR/harness/prepare_docs_site.py" ] && [ "$(git rev-parse --show-toplevel 2>/dev/null || true)" = "$ROOT_DIR" ]; then
    ZENSICAL_CMD=()
    if [ -x "${ROOT_DIR}/.venv_docs/bin/zensical" ]; then
        ZENSICAL_CMD=("${ROOT_DIR}/.venv_docs/bin/zensical")
    elif [ -x "${ROOT_DIR}/.venv/bin/zensical" ]; then
        ZENSICAL_CMD=("${ROOT_DIR}/.venv/bin/zensical")
    elif command -v zensical >/dev/null 2>&1; then
        ZENSICAL_CMD=("$(command -v zensical)")
    elif [ -n "${CONDA_PREFIX:-}" ] && [ -x "${CONDA_PREFIX}/bin/zensical" ]; then
        ZENSICAL_CMD=("${CONDA_PREFIX}/bin/zensical")
    elif [ -x "${HOME}/miniconda3/envs/vardict-oracle/bin/zensical" ]; then
        ZENSICAL_CMD=("${HOME}/miniconda3/envs/vardict-oracle/bin/zensical")
    elif [ -x "${HOME}/miniconda3/bin/zensical" ]; then
        ZENSICAL_CMD=("${HOME}/miniconda3/bin/zensical")
    elif [ -x "${HOME}/miniforge3/bin/zensical" ]; then
        ZENSICAL_CMD=("${HOME}/miniforge3/bin/zensical")
    elif [ -x "${HOME}/.local/bin/zensical" ]; then
        ZENSICAL_CMD=("${HOME}/.local/bin/zensical")
    elif python3 -c "import zensical" >/dev/null 2>&1; then
        ZENSICAL_CMD=("python3" "-m" "zensical")
    fi
    if [ ${#ZENSICAL_CMD[@]} -eq 0 ]; then
        echo "ERROR: Documentation changes detected in push, but 'zensical' was not found in .venv_docs, PATH, or standard conda/user environments." >&2
        echo "Install Zensical before pushing documentation updates: pip install -r docs/requirements.txt" >&2
        exit 1
    fi
    st_t0=$SECONDS
    echo "=== $(ts) [pre-push] Documentation changes detected; running Zensical strict build gate on pushed commit(s) ==="
    CHECKED_DOC_OIDS=" "
    for ((i=0; i<${#REFS[@]}; i+=4)); do
        local_oid="${REFS[i+1]}"
        if [[ "$local_oid" == "$ZERO_OID" ]] || [[ "$CHECKED_DOC_OIDS" == *" $local_oid "* ]]; then
            continue
        fi
        CHECKED_DOC_OIDS="${CHECKED_DOC_OIDS}${local_oid} "
        if git cat-file -e "${local_oid}:harness/prepare_docs_site.py" 2>/dev/null; then
            if git cat-file -e "${local_oid}:zensical.toml" 2>/dev/null || git cat-file -e "${local_oid}:mkdocs.yml" 2>/dev/null; then
                (
                    TMP_DOCS="$(mktemp -d)"
                    trap 'rm -rf "$TMP_DOCS"' EXIT
                    git archive "$local_oid" | tar -x -C "$TMP_DOCS"
                    cd "$TMP_DOCS"
                    python3 "$TMP_DOCS/harness/prepare_docs_site.py"
                    "${ZENSICAL_CMD[@]}" build --clean --strict
                )
            fi
        fi
    done
    echo "$(ts) [pre-push] Zensical strict build PASS ($((SECONDS - st_t0))s)"
fi

# 4c. Fail-closed secret scan across repository history when .gitleaks.toml is present
PUSH_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -n "$PUSH_ROOT" ] && [ -f "$PUSH_ROOT/.gitleaks.toml" ]; then
    [ -f "$ROOT_DIR/harness/lib/portable.sh" ] && source "$ROOT_DIR/harness/lib/portable.sh"
    st_t0=$SECONDS
    echo "=== $(ts) [pre-push] Scanning commits for secrets (gitleaks) ==="
    GITLEAKS_BIN=""
    if declare -F find_gitleaks >/dev/null 2>&1; then
        GITLEAKS_BIN="$(find_gitleaks || true)"
    elif command -v gitleaks >/dev/null 2>&1; then
        GITLEAKS_BIN="$(command -v gitleaks)"
    fi
    if [ -z "$GITLEAKS_BIN" ]; then
        echo "ERROR: gitleaks not found on PATH or in standard conda/user environments (fail-closed secret gate)." >&2
        echo "Install gitleaks (e.g. conda env 'g4-tools' or ~/.local/bin/gitleaks) before pushing." >&2
        exit 1
    fi
    (cd "$PUSH_ROOT" && "$GITLEAKS_BIN" detect --source . -v)
    echo "$(ts) [pre-push] gitleaks PASS ($((SECONDS - st_t0))s)"
fi

# 5. Check whether any non-deletion update touches code, CI, harness, packaging, or engine assets
CODE_CHANGES=$(echo "$ALL_CHANGED_FILES" | grep -E '\.rs$|Cargo\.(toml|lock)$|crates/|harness/|\.github/|\.githooks/|\.agents/|fixtures/|golden/|benchmarks/evidence/|deny\.toml|\.cargo/|packaging/|\.gitleaks|\.pre-commit-config\.yaml|zensical\.toml|mkdocs\.yml|\.readthedocs\.yaml' || true)

if [ -z "$CODE_CHANGES" ]; then
    echo "=== $(ts) [pre-push] Only docs/metadata changed across pushed refs; skipping engine smoke gate ==="
    exit 0
fi

cd "$ROOT_DIR"
[ -f "$ROOT_DIR/harness/lib/portable.sh" ] && source "$ROOT_DIR/harness/lib/portable.sh"
echo "=== $(ts) [pre-push] Code changes detected; running fast pre-push smoke gate (<30s) ==="

st_t0=$SECONDS
echo "$(ts) [pre-push 1/3] Checking formatting and lints..."
cargo fmt --all -- --check
cargo clippy --all-targets --all-features -- -D warnings
echo "$(ts) [pre-push 1/3] PASS ($((SECONDS - st_t0))s)"

st_t0=$SECONDS
echo "$(ts) [pre-push 2/3] Running core engine behavior and CLI crash robustness suites..."
cargo test -p vardictrust-core --test engine_behavior -- --test-threads="$RUST_TEST_THREADS"
cargo test -p vardictrust --test robustness -- --test-threads="$RUST_TEST_THREADS"
echo "$(ts) [pre-push 2/3] PASS ($((SECONDS - st_t0))s)"

st_t0=$SECONDS
echo "$(ts) [pre-push 3/3] Running Tier-2 micro differential check against VarDictJava oracle..."
cargo build -q --release -p vardictrust
export VARDICT_BIN="$ROOT_DIR/target/release/vardictrust"
COMPARE_NO_TIME=1 MIN_VARIANTS=1 bash "$ROOT_DIR/harness/compare.sh" fixtures/micro/micro.ref.fa fixtures/micro/micro.bam fixtures/micro/micro.bed
echo "$(ts) [pre-push 3/3] PASS ($((SECONDS - st_t0))s)"

echo "=== $(ts) [pre-push] All pre-push gates PASSED ($((SECONDS - HOOK_T0))s) ==="
